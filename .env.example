# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector & Redis)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=merchant_platform
APP_DB_NAME=mem0
POSTGRES_COLLECTION_NAME=memories
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6381/0
REDIS_HOST_PORT=6381

# 2. LLM CONFIGURATION (v-LLM cho Agent / Planner / Mem0)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-........
LLM_MODEL_SMALL=gpt-3.5-turbo
LLM_MODEL_LARGE=gpt-4
MEM0_DEFAULT_LLM_MODEL=gpt-3.5-turbo
MEM0_DISABLE_RESPONSE_FORMAT=true

# 3. EMBEDDING CONFIGURATION (Dùng chung cho cả Mem0 & Policy RAG)
# ==============================================================================
# Provider: "huggingface" (chạy local cache) hoặc "openai" (nếu sau này chuyển sang API)
MEM0_EMBEDDER_PROVIDER=huggingface
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIMENSIONS=384
# Cấu hình HuggingFace Cache & Offline Mode
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_CACHE_DIR=/home/minhnv63/.cache/huggingface

# 4. MEM0 SECURITY & DASHBOARD CONFIGURATION
# ==============================================================================
ADMIN_API_KEY=m0sk_.......
MEM0_API_KEY=m0sk_.......
JWT_SECRET=secret
AUTH_DISABLED=false
MEM0_PORT=8888
MEM0_DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
MEM0_TELEMETRY=false
HISTORY_DB_PATH=/app/history/history.db


# 5. LANGFUSE TELEMETRY & OBSERVABILITY
# ==============================================================================
LANGFUSE_SECRET_KEY=sk-lf-......
LANGFUSE_PUBLIC_KEY=pk-lf-........
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production